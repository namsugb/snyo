# Supabase — 대시보드 → Project Settings → API / Connect
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# 아래 둘 중 하나만 설정 (신규: Publishable / 구버전: anon public)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 사진 업로드(Server Action → Storage)에 필요. 절대 NEXT_PUBLIC_ 붙이지 말 것.
# SUPABASE_SERVICE_ROLE_KEY=

# 스키마 적용: 대시보드 SQL Editor에서 supabase/migrations/*.sql 실행 또는 supabase db push
